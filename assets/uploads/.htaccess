# Запрет исполнения любых скриптов в каталоге загрузок (Apache 2.4)
#
# ВНИМАНИЕ: этот файл защищает ТОЛЬКО Apache с AllowOverride All.
# На nginx он игнорируется! Для nginx ОБЯЗАТЕЛЬНО добавьте в server {}:
#
#   location ^~ /assets/uploads/attachments/ { deny all; return 403; }
#   location ~* ^/assets/uploads/.*\.(php|phtml|phar|pl|py|cgi|sh)$ { deny all; }
#
# либо (лучше) вынесите каталог attachments/ за пределы docroot
# и настройте ATTACH_DIR в includes/attachments.php.

<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh|asp|aspx|jsp|shtml|htaccess)$">
    Require all denied
</FilesMatch>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# AllowOverride в .htaccess запрещена (контекст <Directory>) — даёт 500 на все файлы каталога.
# Options может быть запрещена политикой хостинга (AllowOverride без Options) — не роняем запрос.
<IfModule mod_authz_core.c>
    # Apache 2.4: опции задаются в конфиге хостинга; здесь только безопасный минимум
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>

SetHandler none
ForceType application/octet-stream
<FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
    ForceType none
</FilesMatch>

# Вложения — только через /attachment.php (ACL). Прямые URL запрещены.
# Правило относительное (per-dir): работает при установке в любой подкаталог.
# Аватары лежат в avatars/ и под это правило не попадают.
RewriteEngine On
RewriteRule ^attachments/ - [F,L]
