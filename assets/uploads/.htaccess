# Запрет исполнения любых скриптов в каталоге загрузок (Apache 2.4)
<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh|asp|aspx|jsp|shtml|htaccess)$">
    Require all denied
</FilesMatch>

# Двойная страховка: снять обработчики PHP, даже если FilesMatch обойдён конфигом хоста
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Никаких переопределений из вышележащих конфигов и листинга каталога
Options -ExecCGI -Indexes
AllowOverride None

# Загруженные файлы не должны интерпретироваться как HTML/SVG
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>

# Отдать всё как статику без обработчиков
SetHandler none
ForceType application/octet-stream
<FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
    ForceType none
</FilesMatch>

# Вложения — только через /attachment.php (ACL). Прямые URL запрещены.
# Аватары (avatars/) остаются публичной статикой.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/assets/uploads/avatars/ [NC]
RewriteRule ^attachments/ - [F,L]