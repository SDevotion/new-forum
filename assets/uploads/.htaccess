# Запрет исполнения любых скриптов в каталоге загрузок (Apache 2.4)
#
# РЕШЕНО В ЭТОМ ФАЙЛЕ:
# [6.htaccess] Options -Indexes (запрет листинга каталога) — обёрнут в IfModule
#       и не роняет запрос, если политика хостинга запрещает Override Options.
# [6.htaccess] tmp_* файлы перекодирования аватаров явно закрыты от раздачи.
# [6.htaccess] .stats_cache админ-дашборда закрыт от раздачи.
#
# ВНИМАНИЕ: файл защищает ТОЛЬКО Apache с AllowOverride All.
# Для nginx ОБЯЗАТЕЛЬНО добавьте в server {}:
#   location ^~ /assets/uploads/attachments/ { deny all; return 403; }
#   location ~* ^/assets/uploads/.*\.(php|phtml|phar|pl|py|cgi|sh|tmp)$ { deny all; }

<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|sh|asp|aspx|jsp|shtml|htaccess|tmp)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(tmp_|\.stats_cache)">
    Require all denied
</FilesMatch>

RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Листинг каталога запрещён. Если хостинг не разрешает Override Options —
# директива вызовет 500; в таком случае закомментируйте блок и задайте
# Options -Indexes в конфиге vhost.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'none'; sandbox"
</IfModule>

SetHandler none
ForceType application/octet-stream
<FilesMatch "\.(jpg|jpeg|png|gif|webp)$">
    ForceType none
</FilesMatch>

# Вложения — только через /attachment.php (ACL). Прямые URL запрещены.
RewriteEngine On
RewriteRule ^attachments/ - [F,L]